BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=123456789,987654321

DB_PATH=data/hodler.db
TEMPLATES_DIR=templates
OUTPUT_DIR=data/output

# Путь к LibreOffice (для конвертации в PDF)
# Docker: оставь libreoffice
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=libreoffice

# Автоочистка: файлы в OUTPUT_DIR старше N часов удаляются
# (документы после отправки живут в Telegram, локальные копии не нужны)
CLEANUP_MAX_AGE_HOURS=24
CLEANUP_INTERVAL_MIN=60

# Сколько конвертаций DOCX→PDF может идти одновременно (LibreOffice тяжёлый)
PDF_CONCURRENCY=1

# Перед применением миграций к существующей базе делается копия
# data/hodler.db.backup-YYYYMMDD-HHMMSS (0 — отключить)
DB_BACKUP_BEFORE_MIGRATE=1

# Сборка Docker-образа (необязательно).
# Базовые образы golang/debian: по умолчанию зеркало mirror.gcr.io/library.
# Другие варианты: docker.io/library (Docker Hub, лимит 429), dockerhub.timeweb.cloud/library
# DOCKER_REGISTRY=mirror.gcr.io/library
# Прокси Go-модулей, если proxy.golang.org недоступен: https://goproxy.io,direct
# GOPROXY=https://proxy.golang.org,direct

# Часовой пояс для дат сделок и отчётов «за сегодня» (по умолчанию Europe/Moscow)
# TZ=Europe/Moscow

# Уведомления о поступлениях на наши кошельки
# TRC-20 работает без ключа; ключ TronGrid (trongrid.io) снимает ограничение частоты запросов
# TRONGRID_API_KEY=
# ERC-20 и BEP-20: бесплатный ключ Etherscan (etherscan.io/myapikey) — один на обе сети
# ETHERSCAN_API_KEY=
# Как часто проверять кошельки, секунд (0 — не проверять)
# WALLET_POLL_SECONDS=60
